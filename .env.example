# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# MLflow Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=ev_demand_forecasting

# Database / Audit Logging
# For local dev / testing, SQLite is used automatically if Postgres is not configured
DATABASE_URL=sqlite:///./audit.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_forecasting

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
